# Copier ce fichier en `.env` et le remplir. Ce sont les deux valeurs
# PUBLIQUES du site (NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY) :
# elles finissent dans l'app installée, donc jamais la clé `service_role` ici.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# L'adresse du site (NEXT_PUBLIC_SITE_URL), sans « / » final : le lien de
# confirmation de l'email d'inscription et les conditions s'y ouvrent.
EXPO_PUBLIC_SITE_URL=
