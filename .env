# =====================================================================
# Makiti — variables d'environnement PUBLIQUES
# =====================================================================
# Ce fichier est VERSIONNÉ, volontairement. Il ne contient que des valeurs
# préfixées `NEXT_PUBLIC_`, et ce préfixe n'est pas décoratif : Next les
# inscrit en clair dans le JavaScript envoyé au navigateur. Elles sont donc
# déjà lisibles par n'importe quel visiteur qui ouvre les outils de
# développement. Les cacher dans Git ne protégerait rien.
#
# Ce qui protège les données, c'est le RLS écrit dans
# `supabase/migrations/0002_rules_and_security.sql` — pas le secret de
# cette clé.
#
# ---------------------------------------------------------------------
# LA RÈGLE, à ne pas confondre un jour de fatigue
# ---------------------------------------------------------------------
# Ici           : uniquement du `NEXT_PUBLIC_`, rien d'autre. Jamais.
# Dans `.env.local` (ignoré par Git) ou dans le tableau de bord de
# l'hébergeur : tout le reste — la clé `service_role` de Supabase, la clé
# d'API Resend des notifications (étape 7), et tout ce qui viendra ensuite.
#
# La clé `service_role` mérite une mention à part : elle IGNORE le RLS et
# donne un accès total à la base. Si elle atterrit un jour dans ce
# fichier, tout le travail de sécurité des migrations devient décoratif.
#
# ---------------------------------------------------------------------
# Précédence
# ---------------------------------------------------------------------
# Une variable définie dans l'environnement (tableau de bord Vercel,
# variable du shell) GAGNE sur ce fichier — Next n'écrase jamais une
# valeur déjà présente. Ce fichier est donc un filet de sécurité : il
# garantit qu'un build fonctionne même si la configuration de
# l'hébergeur est absente ou mal saisie, sans jamais l'écraser quand elle
# est correcte.
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=https://bfmsruzyrgbndbueikcb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_EfAVbmeOZqp2Nc7EvZtcuw_fRwnPs9C

# La clé PUBLIQUE des notifications push (VAPID). Le navigateur la reçoit
# de toute façon : c'est elle qu'il envoie au service de push de Google ou
# d'Apple pour créer un abonnement, et elle sert ensuite à vérifier que
# c'est bien Makiti qui envoie. Son secret n'existe pas.
#
# Sa moitié PRIVÉE, elle, ne vit QUE dans Vercel (`VAPID_PRIVATE_KEY`) et
# dans `.env.local`. Quiconque l'obtient peut envoyer des notifications au
# nom de Makiti, sur les téléphones de tous les abonnés.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BGrpTb2ylysDA3yiLoqdqebCX0y6V-mjRhwb9AnrI-eLjI_aox-C7iuEAoDllyqWTtsnLth8CB_Dzf6c022zQJA
