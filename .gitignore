node_modules/
.next/
out/
build/
# `.env` est VERSIONNÉ : il ne porte que des valeurs `NEXT_PUBLIC_`, déjà
# envoyées au navigateur de chaque visiteur (voir les commentaires dedans).
# Tout ce qui est réellement secret va dans `.env.local`, jamais suivi.
.env.local
.env*.local
.DS_Store
*.log

# Réglages d'éditeur : ils suivent la personne, pas le projet
.vscode/
.vercel

# canvas assemblé, régénérable depuis design/*.dc.html
design/filloo-maquette.html

# TypeScript
*.tsbuildinfo

# Vérification des largeurs (npm run largeurs) : un profil de navigateur
# et des captures, tous deux régénérables et volumineux.
.chrome-profil/
.captures/

# Tests de navigateur (npm run e2e) : captures, traces et rapport,
# régénérés à chaque passage.
e2e/resultats/
e2e/rapport/

# État local de la CLI Supabase (npx supabase start)
supabase/.temp/
supabase/.branches/
